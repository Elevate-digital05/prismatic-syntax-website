      "statusCode": 301
    },
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "host",
          "value": {
            "suf": "elevatedigitals.co.za"
          }
        }
      ],
      "destination": "https://www.prismaticsyntax.com/blog/:slug",
      "statusCode": 301
